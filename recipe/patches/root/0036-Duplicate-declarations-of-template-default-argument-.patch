From 14b41e05b5ae8e17b0bad56d650f56b11960c72a Mon Sep 17 00:00:00 2001
From: Axel Naumann <Axel.Naumann@cern.ch>
Date: Tue, 10 Sep 2013 17:01:46 +0200
Subject: [PATCH 36/44] Duplicate declarations of template default argument
 from rootmap files are just fine.

---
 clang/lib/Sema/SemaTemplate.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/clang/lib/Sema/SemaTemplate.cpp b/clang/lib/Sema/SemaTemplate.cpp
index 3497ff7856ee..7489c2718fb4 100644
--- a/clang/lib/Sema/SemaTemplate.cpp
+++ b/clang/lib/Sema/SemaTemplate.cpp
@@ -2611,6 +2611,15 @@ bool Sema::CheckTemplateParameterList(TemplateParameterList *NewParams,
       Invalid = true;
     }
 
+    if (RedundantDefaultArg &&
+        (((*OldParam)->hasAttr<AnnotateAttr>() &&
+          (*OldParam)->getAttr<AnnotateAttr>()->getAnnotation() == "rootmap") ||
+         ((*NewParam)->hasAttr<AnnotateAttr>() &&
+          (*NewParam)->getAttr<AnnotateAttr>()->getAnnotation() ==
+              "rootmap"))) {
+      RedundantDefaultArg = false;
+    }
+
     // [basic.def.odr]/13:
     //     There can be more than one definition of a
     //     ...
