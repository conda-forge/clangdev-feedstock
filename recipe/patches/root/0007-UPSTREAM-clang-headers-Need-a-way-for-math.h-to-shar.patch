 clang/lib/Headers/float.h                  | 180 ++-------------------
 clang/lib/Headers/module.modulemap         |  18 ++-
 clang/test/Headers/floatneeds.c            |  41 +++++
 clang/test/Modules/relative-resource-dir.m |   1 +
