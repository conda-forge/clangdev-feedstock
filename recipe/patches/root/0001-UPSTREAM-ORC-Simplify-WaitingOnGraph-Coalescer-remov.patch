+      // Now remove from CanonicalSNs.
+      auto I = CanonicalSNs.find(H);
+      assert(I != CanonicalSNs.end() && "Hash not in CanonicalSNs");
+      auto &SNs = I->second;
+
+      size_t J = 0;
+      for (; J != SNs.size(); ++J)
+        if (SNs[J] == SN)
+          break;
+
+      assert(J < SNs.size() && "SN not in CanonicalSNs map");
+      std::swap(SNs[J], SNs.back());
+      SNs.pop_back();
+
+      if (SNs.empty())
+        CanonicalSNs.erase(I);
     }
 
