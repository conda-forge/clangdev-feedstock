+
+    /// Remove the given node from the Coalescer.
+    void erase(SuperNode *SN) {
+      hash_code H;
+
+      {
+        // Look up hash. We expect to find it in SNHashes.
+        auto I = SNHashes.find(SN);
+        assert(I != SNHashes.end() && "SN not tracked by coalescer");
+        H = I->second;
+        SNHashes.erase(I);
