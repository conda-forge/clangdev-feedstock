From c7cc6afd4c5001e1dec2009214d79e085b1620e4 Mon Sep 17 00:00:00 2001
From: "H. Vetinari" <h.vetinari@gmx.com>
Date: Thu, 29 Oct 2026 15:40:34 +1100
Subject: [PATCH 10/10] Support CLANG_ENABLE_CIR in standalone clang builds

* Ensure mlir_tablegen() gets found by resolving to a real path.
* Fix hard-coded MLIR paths in CIR's CMakeLists internal TableGen targets.
* Only `DEPEND` on MLIR-owned targets if `NOT CLANG_BUILT_STANDALONE`.
---
 clang/CMakeLists.txt                          | 28 ++++++++++++++-----
 clang/include/clang/CIR/CMakeLists.txt        |  5 +---
 .../include/clang/CIR/Dialect/CMakeLists.txt  |  6 +---
 clang/lib/CIR/CMakeLists.txt                  | 10 +++++--
 clang/lib/CIR/CodeGen/CMakeLists.txt          | 11 ++++++--
 clang/lib/CIR/Dialect/Analysis/CMakeLists.txt |  7 ++++-
 clang/lib/CIR/Dialect/IR/CMakeLists.txt       | 11 ++++++--
 clang/lib/CIR/Dialect/OpenACC/CMakeLists.txt  | 17 +++++++----
 clang/lib/CIR/Dialect/OpenMP/CMakeLists.txt   |  7 ++++-
 .../lib/CIR/Dialect/Transforms/CMakeLists.txt | 11 ++++++--
 .../Transforms/TargetLowering/CMakeLists.txt  | 11 ++++++--
 clang/lib/CIR/FrontendAction/CMakeLists.txt   | 13 +++++++--
 clang/lib/CIR/Interfaces/CMakeLists.txt       | 27 +++++++++++-------
 clang/lib/CIR/Lowering/CMakeLists.txt         | 11 ++++++--
 .../CIR/Lowering/DirectToLLVM/CMakeLists.txt  | 11 ++++++--
 clang/lib/FrontendTool/CMakeLists.txt         | 21 +++++++-------
 clang/test/CIR/lib/CMakeLists.txt             |  3 +-
 clang/tools/cir-lsp-server/CMakeLists.txt     |  3 +-
 clang/tools/cir-opt/CMakeLists.txt            |  3 +-
 clang/tools/cir-translate/CMakeLists.txt      |  3 +-
 clang/unittests/CIR/CMakeLists.txt            |  5 +---
 21 files changed, 150 insertions(+), 74 deletions(-)

diff --git a/clang/CMakeLists.txt b/clang/CMakeLists.txt
index a516c7a72ff0..5e86c3b94710 100644
--- a/clang/CMakeLists.txt
+++ b/clang/CMakeLists.txt
@@ -197,13 +197,27 @@ if(CLANG_BUILT_STANDALONE)
 endif()
 
 if(CLANG_ENABLE_CIR)
-  if (CLANG_BUILT_STANDALONE)
-    message(FATAL_ERROR
-      "ClangIR is not yet supported in the standalone build.")
-  endif()
-  if (NOT "mlir" IN_LIST LLVM_ENABLE_PROJECTS)
-    message(FATAL_ERROR
-      "Cannot build ClangIR without MLIR enabled")
+  if(CLANG_BUILT_STANDALONE)
+    find_package(MLIR REQUIRED CONFIG)
+    list(APPEND CMAKE_MODULE_PATH "${MLIR_CMAKE_DIR}")
+    include(AddMLIR)
+    set(CLANG_CIR_MLIR_INCLUDE_DIRS ${MLIR_INCLUDE_DIRS})
+    # MLIRConfig.cmake sets MLIR_TABLEGEN_EXE to the bare tool name;
+    # resolve it to an actual path, like Flang's standalone build does.
+    find_program(CLANG_MLIR_TABLEGEN_EXE "mlir-tblgen"
+      HINTS "${LLVM_TOOLS_BINARY_DIR}")
+    if(NOT CLANG_MLIR_TABLEGEN_EXE)
+      message(FATAL_ERROR "ClangIR requires mlir-tblgen, which was not found. "
+        "Point CLANG_MLIR_TABLEGEN_EXE at it, or add it to PATH.")
+    endif()
+    set(MLIR_TABLEGEN_EXE "${CLANG_MLIR_TABLEGEN_EXE}")
+  else()
+    # The MLIR_*_INCLUDE_DIR variables cannot be used here: MLIR gets configured
+    # after clang, so they are still empty at this point. Derive the same roots
+    # from the LLVM paths instead.
+    set(CLANG_CIR_MLIR_INCLUDE_DIRS
+      "${LLVM_MAIN_SRC_DIR}/../mlir/include"
+      "${LLVM_BINARY_DIR}/tools/mlir/include")
   endif()
 endif()
 
