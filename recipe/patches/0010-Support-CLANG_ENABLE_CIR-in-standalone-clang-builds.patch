From 57318eede770266d346a7ceb6a500abe6b296b9a Mon Sep 17 00:00:00 2001
From: "H. Vetinari" <h.vetinari@gmx.com>
Date: Fri, 30 Oct 2026 14:23:21 +1100
Subject: [PATCH 10/11] Support CLANG_ENABLE_CIR in standalone clang builds

* Ensure mlir_tablegen() gets found by resolving to a real path.
* Fix hard-coded MLIR paths in CIR's CMakeLists internal TableGen targets.
---
 clang/CMakeLists.txt                          | 28 ++++++++++++++-----
 clang/include/clang/CIR/CMakeLists.txt        |  5 +---
 .../include/clang/CIR/Dialect/CMakeLists.txt  |  6 +---
 clang/lib/CIR/CMakeLists.txt                  |  3 +-
 clang/lib/FrontendTool/CMakeLists.txt         |  6 ++--
 clang/test/CIR/lib/CMakeLists.txt             |  3 +-
 clang/tools/cir-lsp-server/CMakeLists.txt     |  3 +-
 clang/tools/cir-opt/CMakeLists.txt            |  3 +-
 clang/tools/cir-translate/CMakeLists.txt      |  3 +-
 clang/unittests/CIR/CMakeLists.txt            |  5 +---
 10 files changed, 31 insertions(+), 34 deletions(-)

diff --git a/clang/CMakeLists.txt b/clang/CMakeLists.txt
index a516c7a72ff0..5e86c3b94710 100644
--- a/clang/CMakeLists.txt
+++ b/clang/CMakeLists.txt
@@ -197,13 +197,27 @@ if(CLANG_BUILT_STANDALONE)
 endif()
 
 if(CLANG_ENABLE_CIR)
-  if (CLANG_BUILT_STANDALONE)
-    message(FATAL_ERROR
-      "ClangIR is not yet supported in the standalone build.")
-  endif()
-  if (NOT "mlir" IN_LIST LLVM_ENABLE_PROJECTS)
-    message(FATAL_ERROR
-      "Cannot build ClangIR without MLIR enabled")
+  if(CLANG_BUILT_STANDALONE)
+    find_package(MLIR REQUIRED CONFIG)
+    list(APPEND CMAKE_MODULE_PATH "${MLIR_CMAKE_DIR}")
+    include(AddMLIR)
+    set(CLANG_CIR_MLIR_INCLUDE_DIRS ${MLIR_INCLUDE_DIRS})
+    # MLIRConfig.cmake sets MLIR_TABLEGEN_EXE to the bare tool name;
+    # resolve it to an actual path, like Flang's standalone build does.
+    find_program(CLANG_MLIR_TABLEGEN_EXE "mlir-tblgen"
+      HINTS "${LLVM_TOOLS_BINARY_DIR}")
+    if(NOT CLANG_MLIR_TABLEGEN_EXE)
+      message(FATAL_ERROR "ClangIR requires mlir-tblgen, which was not found. "
+        "Point CLANG_MLIR_TABLEGEN_EXE at it, or add it to PATH.")
+    endif()
+    set(MLIR_TABLEGEN_EXE "${CLANG_MLIR_TABLEGEN_EXE}")
+  else()
+    # The MLIR_*_INCLUDE_DIR variables cannot be used here: MLIR gets configured
+    # after clang, so they are still empty at this point. Derive the same roots
+    # from the LLVM paths instead.
+    set(CLANG_CIR_MLIR_INCLUDE_DIRS
+      "${LLVM_MAIN_SRC_DIR}/../mlir/include"
+      "${LLVM_BINARY_DIR}/tools/mlir/include")
   endif()
 endif()
 
diff --git a/clang/include/clang/CIR/CMakeLists.txt b/clang/include/clang/CIR/CMakeLists.txt
index 73641606af42..aac485080fe2 100644
--- a/clang/include/clang/CIR/CMakeLists.txt
+++ b/clang/include/clang/CIR/CMakeLists.txt
@@ -1,7 +1,4 @@
-set(MLIR_INCLUDE_DIR ${LLVM_MAIN_SRC_DIR}/../mlir/include ) # --includedir
-set(MLIR_TABLEGEN_OUTPUT_DIR ${LLVM_BINARY_DIR}/tools/mlir/include)
-include_directories(${MLIR_INCLUDE_DIR})
-include_directories(${MLIR_TABLEGEN_OUTPUT_DIR})
+include_directories(${CLANG_CIR_MLIR_INCLUDE_DIRS})
 
 add_subdirectory(Dialect)
 add_subdirectory(Interfaces)
diff --git a/clang/include/clang/CIR/Dialect/CMakeLists.txt b/clang/include/clang/CIR/Dialect/CMakeLists.txt
index 2465b537cd81..26c689020fc4 100644
--- a/clang/include/clang/CIR/Dialect/CMakeLists.txt
+++ b/clang/include/clang/CIR/Dialect/CMakeLists.txt
@@ -5,12 +5,8 @@ add_custom_target(clang-cir-doc)
 # which is not the case for CIR (and also FIR, both have similar workarounds).
 function(add_clang_mlir_doc doc_filename output_file output_directory command)
   set(LLVM_TARGET_DEFINITIONS ${doc_filename}.td)
-  # NB: MLIR_*_INCLUDE_DIR variables cannot be used here: MLIR configures
-  # after Clang, so they are still empty at this point. Derive the same
-  # roots from LLVM dirs instead (as CIR/CMakeLists.txt already does).
   tablegen(MLIR ${output_file}.md ${command} ${ARGN}
-           EXTRA_INCLUDES ${LLVM_MAIN_SRC_DIR}/../mlir/include
-                          ${LLVM_BINARY_DIR}/tools/mlir/include)
+           EXTRA_INCLUDES ${CLANG_CIR_MLIR_INCLUDE_DIRS})
   set(GEN_DOC_FILE ${CLANG_BINARY_DIR}/docs/CIR/_raw/${output_directory}${output_file}.md)
   add_custom_command(
           OUTPUT ${GEN_DOC_FILE}
